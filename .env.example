# 로컬 Supabase 스택을 사용할 때는 `npx supabase start` 실행 후 출력되는 값을 그대로 쓰면 된다.
# (익명 키/서비스 역할 키는 로컬 개발용 고정 데모 키이며 운영 환경 비밀값이 아니다.)
# 프로덕션/클라우드 Supabase 프로젝트를 쓸 때는 해당 프로젝트의 값으로 교체한다.

# 필수 - 브라우저에 노출되는 공개 값만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 필수(서버 전용) - service-role 키는 절대 클라이언트 번들/로그/저장소에 포함하지 않는다.
# 서버 액션, 스케줄 워커, RLS 테스트 하네스에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# 선택 - 마이그레이션/시드 스크립트가 직접 psql로 접근할 때만 필요.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 선택 - 로컬 Inbucket(이메일 테스트 서버) 웹 UI. README 안내용.
NEXT_PUBLIC_INBUCKET_URL=http://127.0.0.1:54324

# 필수 - /auth/confirm이 리다이렉트를 허용할 기본 origin. Host 헤더는 신뢰하지 않고
# 이 값(+ 아래 ALIASES)으로만 허용 목록을 만든다. supabase/config.toml의
# site_url/additional_redirect_urls와 같은 호스트 집합으로 유지할 것.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# 선택 - 쉼표로 구분한 추가 허용 origin. 로컬에서 127.0.0.1과 localhost를 번갈아 접속할 때 사용.
NEXT_PUBLIC_SITE_URL_ALIASES=http://localhost:3000
